# PostgreSQL connection used by Prisma and the application. Replace every token.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required by Auth.js to sign and encrypt session data.
AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
AUTH_URL="http://127.0.0.1:3000"

# Required only when running `pnpm db:seed`.
SEED_ADMIN_USERNAME="ADMIN_EMPLOYEE_ID"
SEED_ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS"
